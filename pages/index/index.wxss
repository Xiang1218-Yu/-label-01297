.header {
  margin-bottom: 40rpx;
  padding: 0 16rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
}

.salary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  cursor: pointer;
}

.toggle-icon {
  font-size: 24rpx;
  color: #999;
  transition: transform 0.3s;
}

.total-salary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f4ff 100%);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.total-label {
  font-size: 28rpx;
  color: #2f80ed;
  font-weight: 500;
}

.total-value {
  font-size: 36rpx;
  color: #2f80ed;
  font-weight: bold;
}

.salary-detail {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.salary-detail .form-item:last-child {
  margin-bottom: 0;
}

.label-row {
  margin-bottom: 16rpx;
}

.label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.input-money {
  font-size: 56rpx;
  font-weight: bold;
  color: #2f80ed;
  height: 80rpx;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 8rpx;
}

.salary-detail .input-money {
  font-size: 40rpx;
  height: 60rpx;
}

.picker-display {
  font-size: 36rpx;
  color: #333333;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  text-align: center;
  border: 1px solid transparent;
}

.picker-display:active {
  border-color: #2f80ed;
  background: #fff;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 32rpx 0;
}

.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.chip {
  padding: 12rpx 24rpx;
  background: #f0f2f5;
  color: #666666;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.chip.active {
  background: #2f80ed;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(47, 128, 237, 0.3);
}

.btn-primary {
  width: 100%;
  background: #2f80ed;
  color: #fff;
  border-radius: 48rpx;
  font-weight: bold;
  font-size: 32rpx;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, 0.25);
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  width: 100%;
  background: transparent;
  color: #666666;
  border: 2rpx solid #eee;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  margin-top: 32rpx;
}

.btn-outline::after {
  border: none;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tag-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.tag-text {
  font-size: 24rpx;
}

.tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.tag-danger {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.reset-btn {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reset-icon {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.timer-display {
  text-align: center;
  margin-bottom: 48rpx;
}

.timer-label {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 16rpx;
}

.timer-number {
  font-size: 80rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', monospace;
  color: #333333;
  letter-spacing: 2rpx;
}

.text-danger {
  color: #ff4d4f;
}

.money-display {
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f4ff 100%);
  padding: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.money-label {
  font-size: 26rpx;
  color: #5b8cff;
  display: block;
  margin-bottom: 8rpx;
}

.money-amount-row {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.symbol {
  font-size: 32rpx;
  color: #2f80ed;
  margin-right: 8rpx;
}

.amount {
  font-size: 64rpx;
  font-weight: bold;
  color: #2f80ed;
}

.salary-breakdown {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(47, 128, 237, 0.1);
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.breakdown-label {
  font-size: 24rpx;
  color: rgba(47, 128, 237, 0.7);
}

.breakdown-value {
  font-size: 28rpx;
  color: #2f80ed;
  font-weight: 600;
}

.loss-display {
  margin-top: 24rpx;
}

.loss-card {
  background: #fff1f0;
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid rgba(255, 77, 79, 0.1);
}

.loss-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.loss-label {
  color: #ff4d4f;
  font-weight: 500;
}

.loss-amount {
  color: #ff4d4f;
  font-weight: bold;
  font-size: 36rpx;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

@keyframes pulse-red {
  0% { transform: scale(1); color: #ff4d4f; }
  50% { transform: scale(1.05); color: #ff7875; }
  100% { transform: scale(1); color: #ff4d4f; }
}

.pulse {
  animation: pulse 0.2s ease-in-out;
}

.pulse-red {
  animation: pulse-red 0.2s ease-in-out;
}

.footer {
  margin-top: auto;
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  color: #ccc;
  font-size: 24rpx;
}
