.header {
  margin-bottom: 24rpx;
  padding: 0 16rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.record-card {
  margin-bottom: 24rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.delete-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: rgba(255, 77, 79, 0.1);
}

.delete-icon {
  font-size: 28rpx;
}

.record-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tag-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.tag-text {
  font-size: 24rpx;
}

.tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.record-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.money-display {
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f4ff 100%);
  padding: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}

.money-label {
  font-size: 26rpx;
  color: #5b8cff;
  display: block;
  margin-bottom: 8rpx;
}

.money-amount-row {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.symbol {
  font-size: 32rpx;
  color: #2f80ed;
  margin-right: 8rpx;
}

.amount {
  font-size: 64rpx;
  font-weight: bold;
  color: #2f80ed;
}

.profit-display {
  margin-top: 24rpx;
}

.profit-card {
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.profit-positive .profit-card {
  background: #f6ffed;
  border-color: rgba(82, 196, 26, 0.1);
}

.profit-negative .profit-card {
  background: #fff1f0;
  border-color: rgba(255, 77, 79, 0.1);
}

.profit-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.profit-label {
  font-weight: 500;
}

.profit-positive .profit-label {
  color: #52c41a;
}

.profit-negative .profit-label {
  color: #ff4d4f;
}

.profit-amount {
  font-weight: bold;
  font-size: 36rpx;
}

.profit-positive .profit-amount {
  color: #52c41a;
}

.profit-negative .profit-amount {
  color: #ff4d4f;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.footer {
  margin-top: auto;
  text-align: center;
  padding: 24rpx 0;
}

.btn-outline {
  width: 100%;
  background: transparent;
  color: #666666;
  border: 2rpx solid #eee;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.btn-outline::after {
  border: none;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}
