<view class="container">
  <view class="header">
    <text class="title">下班打卡记录</text>
    <text class="subtitle" wx:if="{{records.length > 0}}">共 {{records.length}} 条记录</text>
  </view>

  <view class="empty-state" wx:if="{{records.length === 0}}">
    <text class="empty-text">暂无打卡记录</text>
    <text class="empty-hint">开始倒计时后点击下班打卡即可记录</text>
  </view>

  <view class="record-list" wx:else>
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-header">
        <text class="record-date">{{item.date}}</text>
        <view class="delete-btn" bindtap="deleteRecord" data-id="{{item.id}}">
          <text class="delete-text">删除</text>
        </view>
      </view>

      <view class="record-content">
        <view class="record-item">
          <text class="record-label">日薪</text>
          <text class="record-value">¥{{item.dailySalary}}</text>
        </view>

        <view class="record-item">
          <text class="record-label">当日盈亏</text>
          <text class="record-value {{item.profitLoss >= 0 ? 'profit' : 'loss'}}">
            {{item.profitLoss >= 0 ? '+' : ''}}¥{{item.profitLoss}}
          </text>
        </view>

        <view class="record-item">
          <text class="record-label">下班时间</text>
          <text class="record-value">{{item.checkOutTime}}</text>
        </view>
      </view>
    </view>

    <button class="btn-clear" bindtap="clearAllRecords">清空所有记录</button>
  </view>
</view>
