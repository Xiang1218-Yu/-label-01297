<view class="container">
  <view class="page-header">
    <text class="page-title">下班记录</text>
    <text class="page-subtitle">Work History</text>
  </view>

  <view class="toolbar">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回首页</text>
    </view>
    <view class="clear-btn" bindtap="clearAllRecords" wx:if="{{!isEmpty}}">
      <text class="clear-text">清空记录</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{isEmpty}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无下班记录</text>
    <text class="empty-hint">开始工作后点击下班打卡即可记录哦~</text>
  </view>

  <view class="record-list" wx:else>
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-header">
        <view class="date-info">
          <text class="date">{{item.date}}</text>
          <text class="time">下班时间: {{item.offWorkTime}}</text>
        </view>
        <view class="delete-btn" bindtap="deleteRecord" data-id="{{item.id}}">
          <text class="delete-icon">×</text>
        </view>
      </view>

      <view class="record-content">
        <view class="info-item">
          <text class="info-label">日薪</text>
          <view class="info-value-wrapper">
            <text class="info-symbol salary-symbol">¥</text>
            <text class="info-value salary-value">{{item.dailySalary}}</text>
          </view>
        </view>
        <view class="info-item">
          <text class="info-label">当日盈亏</text>
          <view class="info-value-wrapper">
            <text class="info-symbol {{item.isProfit ? 'profit-symbol' : 'loss-symbol'}}">
              {{item.isProfit ? '+' : ''}}¥
            </text>
            <text class="info-value {{item.isProfit ? 'profit-value' : 'loss-value'}}">
              {{item.profitLossAbs}}
            </text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
