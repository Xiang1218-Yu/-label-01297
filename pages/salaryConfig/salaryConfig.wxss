/* 页面头部 - 与首页风格一致 */
.header {
  margin-bottom: 40rpx;
  padding: 0 16rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
}

/* 模式切换卡片 */
.modeSwitchCard {
  padding: 28rpx 32rpx;
}

.modeSwitchRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modeInfo {
  flex: 1;
}

.modeTitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.modeDesc {
  font-size: 26rpx;
  color: #999;
}

/* 通用卡片样式 - 继承app.wxss */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.sectionTitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.addBtn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #f0f7ff;
  border-radius: 28rpx;
}

.addBtn:active {
  background: #e6f0ff;
}

.addIcon {
  font-size: 28rpx;
  color: #2f80ed;
  margin-right: 6rpx;
  font-weight: bold;
}

.addText {
  font-size: 26rpx;
  color: #2f80ed;
}

/* 简单模式输入 */
.simpleInputRow {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.currencySymbol {
  font-size: 48rpx;
  color: #2f80ed;
  font-weight: bold;
  margin-right: 16rpx;
}

.simpleInput {
  flex: 1;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  height: 80rpx;
}

.inputHint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}

/* 薪资项目列表 */
.componentList {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.componentItem {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.componentItem:last-child {
  border-bottom: none;
}

/* 自定义项目样式与默认项目保持一致 */
.customItem {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.itemLeft {
  display: flex;
  align-items: center;
  flex: 1;
}

.itemIcon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.itemName {
  font-size: 30rpx;
  color: #333;
}

.itemRight {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.itemInputWrap {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  min-width: 160rpx;
}

.itemCurrency {
  font-size: 28rpx;
  color: #999;
  margin-right: 8rpx;
}

.itemInput {
  font-size: 32rpx;
  color: #333;
  width: 120rpx;
  text-align: right;
}

.deleteBtn {
  width: 48rpx;
  height: 48rpx;
  background: #fff1f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.deleteBtn:active {
  background: #ffccc7;
}

.deleteIcon {
  font-size: 32rpx;
  color: #ff4d4f;
  line-height: 1;
}

/* 总计卡片 */
.totalCard {
  background: linear-gradient(135deg, #2f80ed 0%, #1a68d1 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, 0.3);
}

.totalRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.totalLabel {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
}

.totalAmountWrap {
  display: flex;
  align-items: baseline;
}

.totalCurrency {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 8rpx;
}

.totalAmount {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
}

.totalHint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 16rpx;
  display: block;
}

/* 底部按钮 */
.footer {
  padding: 32rpx 0 48rpx;
}

.saveBtn {
  width: 100%;
  background: #2f80ed;
  color: #fff;
  border-radius: 48rpx;
  font-weight: bold;
  font-size: 32rpx;
  padding: 28rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(47, 128, 237, 0.25);
}

.saveBtn::after {
  border: none;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}
